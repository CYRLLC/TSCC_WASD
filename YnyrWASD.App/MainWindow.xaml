<Window x:Class="YnyrWASD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:YnyrWASD.App"
        Title="{app:T Zh='YnyrWASD · 自動偵測 NS2 Pro / Xbox → DualShock 4', En='YnyrWASD · Auto-detect NS2 Pro / Xbox → DualShock 4'}"
        Icon="Assets/YnyrWASD.ico" Width="980" Height="780"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#101827" Foreground="#EDF3FF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="#DDE9FC"/>
            <Setter Property="Foreground" Value="#10203A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EDF3FF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB8DD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,0,0,10"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="YnyrWASD" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="{app:T Zh='自動偵測 NS2 Pro（USB）／Xbox 手把，轉為虛擬 PS4 控制器', En='Turns an NS2 Pro (USB) or Xbox controller into a virtual PS4 controller'}"
                       Foreground="#9FB8DD" FontSize="15"/>
            <TextBlock Text="{app:T Zh='PS 按鍵圖示取決於遊戲支援。ViGEmBus 已停止維護；安裝 HidHide 後可自動隱藏實體手把。', En='PS prompts depend on the game. ViGEmBus is end-of-life; install HidHide to hide the physical controller automatically.'}"
                       Foreground="#E7C98A" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="{app:T Zh=新增, En=New}" Command="{Binding NewCommand}"/>
                    <Button Content="{app:T Zh=移除, En=Remove}" Command="{Binding DeleteCommand}"/>
                    <Button Content="{app:T Zh=匯入, En=Import}" Command="{Binding ImportCommand}"/>
                    <Button Content="{app:T Zh=匯出全部, En='Export all'}" Command="{Binding ExportCommand}"/>
                </WrapPanel>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                         IsEnabled="{Binding CanEdit}" Background="#19263B" Foreground="#EDF3FF"
                         BorderBrush="#354763" AutomationProperties.Name="{app:T Zh=設定檔清單, En=Profiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="8" FontSize="15"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{app:T Zh=設定檔, En=Profile}" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="{app:T Zh=輸入手把, En='Input controller'}"/>
                        <ComboBox ItemsSource="{Binding InputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type"
                                  SelectedValue="{Binding SelectedProfile.InputType, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="8" Margin="0,4,0,12" AutomationProperties.Name="{app:T Zh=輸入手把, En='Input controller'}"/>
                        <CheckBox IsChecked="{Binding SelectedProfile.HidePhysicalControllers}"
                                  Content="{app:T Zh='映射時自動隱藏實體手把（需 HidHide）', En='Hide physical controllers while mapping (needs HidHide)'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{app:T Zh='讓遊戲只看到虛擬 DS4，避免按鍵圖示在 Xbox／PS 之間跳動。請先啟動映射再開遊戲；停止映射後自動還原。', En='Games then only see the virtual DS4, so prompts stop flipping between Xbox and PS. Start mapping before the game; stopping restores everything.'}"/>
                        <CheckBox IsChecked="{Binding SelectedProfile.ForwardRumble}"
                                  Content="{app:T Zh=把遊戲震動轉給實體手把, En='Forward game rumble to the physical controller'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{app:T Zh='NS2 Pro 的 Home 鍵對應 PS 鍵、截圖鍵對應觸控板按下；陀螺儀會轉成 DS4 體感。', En='NS2 Pro Home maps to PS, Capture to touchpad click, and its gyro becomes DS4 motion.'}"/>

                        <TextBlock Text="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                        <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                        <TextBlock Text="{app:T Zh=說明, En=Description}"/>
                        <TextBox Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{app:T Zh=設定檔說明, En='Profile description'}"/>
                        <TextBlock Text="{app:T Zh='搖桿死區（0–0.95）', En='Stick dead zone (0–0.95)'}"/>
                        <DockPanel Margin="0,8,0,16">
                            <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding SelectedProfile.DeadZone, StringFormat=F2}"/>
                            <Slider Minimum="0" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedProfile.DeadZone}" AutomationProperties.Name="{app:T Zh=搖桿死區, En='Dead zone'}"/>
                        </DockPanel>
                        <TextBlock Text="{app:T Zh='目標輪詢頻率（30–500 Hz；實際頻率受系統排程影響）', En='Target polling rate (30–500 Hz; Windows scheduling affects the actual rate)'}"/>
                        <DockPanel Margin="0,8,0,16">
                            <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding SelectedProfile.PollingRateHz}"/>
                            <Slider Minimum="30" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedProfile.PollingRateHz}" AutomationProperties.Name="{app:T Zh=輪詢頻率, En='Polling rate'}"/>
                        </DockPanel>
                    </StackPanel>
                    <Button Content="{app:T Zh='校準 NS2 Pro 搖桿', En='Calibrate NS2 Pro sticks'}" Command="{Binding CalibrateCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                               Text="{app:T Zh='推到底卻只像輕推、或放開時會飄移時使用；映射中也可以校準，儲存後立即套用。', En='Use this if a full push feels like a light one or the stick drifts at rest. Works while mapping; applies as soon as you save.'}"/>
                    <WrapPanel>
                        <Button Content="{app:T Zh=儲存全部, En='Save all'}" Command="{Binding SaveCommand}"/>
                        <Button Content="{app:T Zh=重新載入, En=Reload}" Command="{Binding ReloadCommand}"/>
                        <Button Content="{app:T Zh=設定資料夾, En='Settings folder'}" Command="{Binding OpenProfilesCommand}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                               Text="{app:T Zh='編輯、新增與移除後請按儲存；重新載入或關閉會捨棄未儲存修改。', En='Click Save all after editing; reloading or closing discards unsaved changes.'}"/>

                    <TextBlock Text="{app:T Zh=程式設定, En='App settings'}" Style="{StaticResource Section}" Margin="0,24,0,10"/>
                    <CheckBox IsChecked="{Binding StartWithWindows}"
                              Content="{app:T Zh=登入 Windows 時自動啟動並開始映射, En='Start with Windows and begin mapping'}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{app:T Zh='開機後縮在系統匣直接映射，搭配下面兩項就不必再手動重啟 Steam。', En='Runs in the notification area right after sign-in. With the two Steam options below you never need to restart Steam by hand.'}"/>
                    <CheckBox IsChecked="{Binding StartMappingOnLaunch}"
                              Content="{app:T Zh=每次開啟程式就自動開始映射, En='Begin mapping whenever the app opens'}"/>
                    <CheckBox IsChecked="{Binding ManageSteam}"
                              Content="{app:T Zh=自動開始映射時，若 Steam 已先開啟就自動重啟它, En='On automatic start, restart Steam if it started first'}"/>
                    <CheckBox IsChecked="{Binding LaunchSteamAfterAutoStart}"
                              Content="{app:T Zh=自動開始映射後啟動 Steam, En='Launch Steam after an automatic start'}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{app:T Zh='建議同時在 Steam 設定關閉「電腦開機時執行 Steam」，讓 Steam 一律在隱藏手把之後才啟動。', En='Also turn off Steam’s own “Run Steam when my computer starts” so Steam always starts after the controllers are hidden.'}"/>
                    <CheckBox IsChecked="{Binding MinimizeToTray}"
                              Content="{app:T Zh=最小化時縮到系統匣, En='Minimize to the notification area'}"/>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{app:T Zh='語言（重新開啟後套用）', En='Language (applies after restart)'}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding Language}" Width="180" HorizontalAlignment="Left" Padding="6"
                                  AutomationProperties.Name="{app:T Zh=語言, En=Language}"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="#19263B" CornerRadius="10" Padding="16" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="{Binding DependencyStatus}" Foreground="#9FB8DD" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="{app:T Zh=官方驅動下載, En='Driver downloads'}" Command="{Binding InstallDepsCommand}"/>
                    <Button Content="{app:T Zh=啟動映射, En='Start mapping'}" Command="{Binding StartCommand}" FontWeight="Bold"/>
                    <Button Content="{app:T Zh=停止, En=Stop}" Command="{Binding StopCommand}"/>
                    <Button Content="{app:T Zh='重新啟動 Steam', En='Restart Steam'}" Command="{Binding RestartSteamCommand}"
                            ToolTip="{app:T Zh='讓 Steam 只看到虛擬 DS4（映射中才可使用）', En='Make Steam see only the virtual DS4 (while mapping)'}"/>
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding InputSummary}" Foreground="#9FB8DD" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
