<Window x:Class="YnyrWASD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YnyrWASD · NS2 Pro / XInput → DualShock 4" Width="980" Height="740"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#101827" Foreground="#EDF3FF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="#DDE9FC"/>
            <Setter Property="Foreground" Value="#10203A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="YnyrWASD" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="將 NS2 Pro（USB）或 XInput 手把轉為虛擬 PS4 控制器" Foreground="#9FB8DD" FontSize="15"/>
            <TextBlock Text="PS 按鍵圖示取決於遊戲支援。ViGEmBus 已停止維護；HidHide 需自行設定。"
                       Foreground="#E7C98A" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="新增" Command="{Binding NewCommand}"/>
                    <Button Content="移除" Command="{Binding DeleteCommand}"/>
                    <Button Content="匯入" Command="{Binding ImportCommand}"/>
                    <Button Content="匯出全部" Command="{Binding ExportCommand}"/>
                </WrapPanel>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                         IsEnabled="{Binding CanEdit}" Background="#19263B" Foreground="#EDF3FF"
                         BorderBrush="#354763" AutomationProperties.Name="設定檔清單">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="8" FontSize="15"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="輸入手把"/>
                        <ComboBox ItemsSource="{Binding InputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type"
                                  SelectedValue="{Binding SelectedProfile.InputType, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="8" Margin="0,4,0,12" AutomationProperties.Name="輸入手把"/>
                        <TextBlock Text="設定檔名稱"/>
                        <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 AutomationProperties.Name="設定檔名稱"/>
                        <TextBlock Text="說明"/>
                        <TextBox Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="設定檔說明"/>
                        <TextBlock Text="搖桿死區（0–0.95）"/>
                        <DockPanel Margin="0,8,0,16">
                            <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding SelectedProfile.DeadZone, StringFormat=F2}"/>
                            <Slider Minimum="0" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedProfile.DeadZone}" AutomationProperties.Name="搖桿死區"/>
                        </DockPanel>
                        <TextBlock Text="目標輪詢頻率（30–500 Hz；實際頻率受系統排程影響）"/>
                        <DockPanel Margin="0,8,0,16">
                            <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding SelectedProfile.PollingRateHz}"/>
                            <Slider Minimum="30" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedProfile.PollingRateHz}" AutomationProperties.Name="輪詢頻率"/>
                        </DockPanel>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="儲存全部" Command="{Binding SaveCommand}"/>
                        <Button Content="重新載入" Command="{Binding ReloadCommand}"/>
                        <Button Content="設定資料夾" Command="{Binding OpenProfilesCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="編輯、新增與移除後請按儲存；重新載入或關閉會捨棄未儲存修改。" Foreground="#9FB8DD"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="#19263B" CornerRadius="10" Padding="16" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="{Binding DependencyStatus}" Foreground="#9FB8DD" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="官方驅動下載" Command="{Binding InstallDepsCommand}"/>
                    <Button Content="啟動映射" Command="{Binding StartCommand}" FontWeight="Bold"/>
                    <Button Content="停止" Command="{Binding StopCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding InputSummary}" Foreground="#9FB8DD" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
